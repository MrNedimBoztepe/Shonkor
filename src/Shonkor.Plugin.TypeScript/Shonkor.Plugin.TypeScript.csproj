<Project Sdk="Microsoft.NET.Sdk">

  <!--
    First-party Shonkor plugin: the JS/TS base parser (#292, epic #296). Unlike the CMS plugins this one
    owns a NODE SIDECAR (sidecar/index.js) that runs the real TypeScript Compiler API, behind a thin
    IFileParser adapter. It is NOT part of the host app — it builds a single assembly that only runs once the
    plugin is activated. The host provides the contract (Shonkor.Core) and the logging abstraction at runtime.

    Esprima is the plugin's PRIVATE fallback dependency: when Node is missing/hangs the adapter degrades to
    the same Esprima tolerant parse the host used to run in-process, so JS/TS indexing never simply stops
    (AC#3). It is copied next to the plugin dll (see CopyEsprimaToOutput) because the plugin loads in an
    isolated AssemblyLoadContext and must carry its own private deps.

    The Node sidecar (index.js + package.json + a pinned typescript in node_modules) is copied verbatim into
    the plugin folder. `npm ci` runs at build time to materialise node_modules (best-effort: a build without
    npm/network still compiles, and the adapter then degrades to Esprima at runtime — exactly AC#3).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- A plugin ships only its own assembly + explicitly-bundled private deps; the host supplies the rest. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Node sidecar node_modules can hold paths longer than the default; keep the build robust. -->
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Contract is provided by the host; reference for compile only (Private=false). -->
    <ProjectReference Include="..\Shonkor.Core\Shonkor.Core.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The test project drives the parser directly (real Node round-trip) via internal test hooks. -->
    <InternalsVisibleTo Include="Shonkor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logging abstraction: host-shared across the ALC boundary (#306). Compile-only, never copied. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Esprima: the plugin's PRIVATE degradation parser. GeneratePathProperty so we can copy its dll below. -->
    <PackageReference Include="Esprima" Version="3.0.6" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="sidecar.settings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sidecar sources (never node_modules — that is generated by npm ci below and copied by CopySidecar). -->
    <None Include="sidecar\index.js" CopyToOutputDirectory="PreserveNewest" Link="sidecar\index.js" />
    <None Include="sidecar\package.json" CopyToOutputDirectory="PreserveNewest" Link="sidecar\package.json" />
    <None Include="sidecar\package-lock.json" CopyToOutputDirectory="PreserveNewest" Link="sidecar\package-lock.json" Condition="Exists('sidecar\package-lock.json')" />
  </ItemGroup>

  <!--
    Up-to-date INPUT list for PackPluginZip (#350). It exists at project level because a target's `Inputs`
    attribute is evaluated BEFORE the target body runs — an ItemGroup inside the body (as used for the actual
    payload below) is still empty at that moment and would make the target permanently out of date.

    It is deliberately NOT reused as the payload: on a clean clone node_modules does not exist yet at
    evaluation time (NpmInstallSidecar materialises it during the same build), so this list can be short on
    the very first build. That is harmless for the up-to-date check — the output ZIP does not exist then
    either, so the target runs and the body re-globs the real, complete tree. From the second build on the
    list is complete, and a changed package.json/package-lock.json re-triggers packing even if the freshly
    installed node_modules were not visible to this glob.

    A timestamp comparison is blind to DELETIONS: removing a file changes the mtime of its directory, not of
    any input, so the ZIP would keep shipping a file that no longer exists in the source tree — a green build
    with a wrong artifact. The list is therefore also written to a stamp file that participates in Inputs; the
    SDK solves the identical problem the identical way in _GenerateCompileDependencyCache
    ("This handles cases where items are added or removed from a glob ... and can't otherwise be detected with
    timestamp comparisons"). WriteOnlyWhenDifferent keeps a no-op build a no-op: the stamp is only rewritten,
    and only then newer than the ZIP, when the SET of files actually changed.
  -->
  <ItemGroup>
    <_PackPluginZipInput Include="$(MSBuildProjectDirectory)\sidecar\**\*"
                         Exclude="$(MSBuildProjectDirectory)\sidecar\node_modules\.cache\**\*" />
    <_PackPluginZipInput Include="plugin.json;sidecar.settings.json" />
  </ItemGroup>

  <Target Name="WritePackPluginZipInputList">
    <WriteLinesToFile File="$(IntermediateOutputPath)packinputs.txt" Lines="@(_PackPluginZipInput)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <!--
    CopyLocalLockFileAssemblies=false suppresses ALL package runtime assets, so bring Esprima.dll back
    explicitly: it is the one private dependency the plugin must carry into its own folder.
  -->
  <Target Name="CopyEsprimaToOutput" AfterTargets="Build">
    <ItemGroup>
      <_EsprimaDll Include="$(PkgEsprima)\lib\netstandard2.1\Esprima.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_EsprimaDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Materialise the sidecar's node_modules (pinned typescript) and copy the whole sidecar tree to output.
    Best-effort: ContinueOnError so a machine without npm/network still produces a working .NET build; the
    adapter then finds no sidecar deps at runtime and degrades to Esprima (AC#3). `npm ci` is skipped when
    node_modules already exists to keep incremental builds fast.
  -->
  <Target Name="NpmInstallSidecar" BeforeTargets="Build"
          Condition="!Exists('$(MSBuildProjectDirectory)\sidecar\node_modules')">
    <Exec Command="npm ci --omit=dev --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)\sidecar"
          ContinueOnError="true" Condition="Exists('$(MSBuildProjectDirectory)\sidecar\package-lock.json')" />
    <Exec Command="npm install --omit=dev --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)\sidecar"
          ContinueOnError="true" Condition="!Exists('$(MSBuildProjectDirectory)\sidecar\package-lock.json')" />
  </Target>

  <Target Name="CopySidecarToOutput" AfterTargets="Build">
    <ItemGroup>
      <_SidecarFiles Include="$(MSBuildProjectDirectory)\sidecar\**\*"
                     Exclude="$(MSBuildProjectDirectory)\sidecar\node_modules\.cache\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SidecarFiles)"
          DestinationFiles="@(_SidecarFiles->'$(OutDir)sidecar\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="TypeScript plugin sidecar copied to $(OutDir)sidecar" />
  </Target>

  <!--
    AC#7 (loud release): the NpmInstallSidecar step is best-effort (ContinueOnError) so a dev machine without
    npm/network still compiles and the adapter degrades to Esprima at runtime. But a RELEASE artifact that
    ships without the sidecar deps would be a silently-degraded package (no real TS Compiler API), so in
    Release we FAIL the build loudly if the pinned typescript is not materialised — it must never be shipped
    that way. Debug is unaffected (dev build keeps compiling).
  -->
  <Target Name="VerifySidecarReleaseDeps" BeforeTargets="PackPluginZip" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\sidecar\node_modules\typescript\package.json')"
           Text="Release packaging of the TypeScript plugin requires the Node sidecar's node_modules (pinned typescript), but 'npm ci' did not materialise it (no npm/network on this machine?). A release artifact must not ship without the sidecar deps — install Node/npm so 'npm ci' can run, then rebuild. (A local Debug build still compiles and degrades to Esprima at runtime.)" />
  </Target>

  <!--
    AC#1 (installable package): stage the full plugin (manifest + entry DLL + the private Esprima fallback +
    the WHOLE sidecar tree incl. node_modules) and zip it to $(OutDir)$(AssemblyName).zip. Mirrors the Kentico
    PackPluginZip shape, but a TS plugin is not a lone DLL — the Node sidecar and its pinned typescript are
    part of the artifact. DependsOnTargets guarantees the Esprima.dll copy has already run; the sidecar is
    staged from the project's source tree (the source of truth for node_modules) rather than racing the
    OutDir copy. This same ZIP is embedded by Shonkor.Infrastructure to seed the plugin default-active (#313).

    Incremental (#350): without Inputs/Outputs this target deleted and rewrote 4.85 MB on EVERY build, even a
    no-op one — which churned the one file a second project embeds, and made Infrastructure the only project
    whose csc re-ran on a no-op solution build. It now packs only when the manifest, the assemblies or the
    sidecar tree actually changed — including when a file is REMOVED from it, which a pure timestamp
    comparison cannot see (hence the packinputs.txt stamp in the Inputs list; see WritePackPluginZipInputList).

    The ZIP is written into obj and then MOVED over the bin file, which shrinks the window in which the
    published artifact is unavailable to a concurrent reader from a multi-second zip write to a rename. It
    does not close it: Move deletes the destination before renaming, and a reader that hits exactly that
    sub-millisecond gap sees a missing file and fails loudly (MSB3030 — no retry applies to a missing source).
    That is the deliberate trade. Copying with retries instead would expose a half-written ZIP, i.e. swap a
    loud failure for silent corruption.

    AfterTargets="CoreBuild", NOT "Build" (#350): 'Build' is BeforeBuild;CoreBuild;AfterBuild, so hooking
    CoreBuild puts this target INSIDE the Build target's dependency chain — the Build target cannot report
    completion before the package exists. Hooked to "Build" it instead ran as a separate entry-point target
    scheduled after Build's own result was already cached, so a ProjectReference consumer could be handed that
    result and start compiling while this target was still zipping. That is not theory: it failed on CI as
    'MSB3030: Could not copy ... Shonkor.Plugin.TypeScript.zip because it was not found'. Everything this
    target needs (the DLL in $(OutDir)) is in place after CoreBuild.

    Every prerequisite is therefore named in DependsOnTargets rather than left to target ordering.
    NpmInstallSidecar is one of them: BeforeTargets="Build" does NOT run before the compile — Build's
    DependsOnTargets chain (BeforeBuild;CoreBuild;AfterBuild) is resolved first, so 'npm ci' actually runs
    after CoreBuild. Packaging from CoreBuild without declaring that dependency packed a plugin whose
    node_modules did not exist yet, which the Release guard correctly rejected. WritePackPluginZipInputList is
    another: DependsOnTargets runs before this target's Inputs/Outputs are evaluated, which is exactly what
    makes the stamp file usable as an input.
  -->
  <Target Name="PackPluginZip" AfterTargets="CoreBuild"
          DependsOnTargets="NpmInstallSidecar;CopyEsprimaToOutput;WritePackPluginZipInputList"
          Inputs="@(_PackPluginZipInput);$(IntermediateOutputPath)packinputs.txt;$(OutDir)$(AssemblyName).dll;$(OutDir)Esprima.dll"
          Outputs="$(OutDir)$(AssemblyName).zip">
    <PropertyGroup>
      <PluginStage>$(IntermediateOutputPath)pluginpack\</PluginStage>
      <PluginStageZip>$(IntermediateOutputPath)$(AssemblyName).zip</PluginStageZip>
      <PluginZip>$(OutDir)$(AssemblyName).zip</PluginZip>
    </PropertyGroup>
    <RemoveDir Directories="$(PluginStage)" />
    <MakeDir Directories="$(PluginStage)" />
    <Copy SourceFiles="plugin.json" DestinationFolder="$(PluginStage)" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll" DestinationFolder="$(PluginStage)" />
    <Copy SourceFiles="$(OutDir)Esprima.dll" DestinationFolder="$(PluginStage)" />
    <Copy SourceFiles="sidecar.settings.json" DestinationFolder="$(PluginStage)" Condition="Exists('sidecar.settings.json')" />
    <ItemGroup>
      <_PackSidecarFiles Include="$(MSBuildProjectDirectory)\sidecar\**\*"
                         Exclude="$(MSBuildProjectDirectory)\sidecar\node_modules\.cache\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PackSidecarFiles)"
          DestinationFiles="@(_PackSidecarFiles->'$(PluginStage)sidecar\%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(PluginStage)" DestinationFile="$(PluginStageZip)" Overwrite="true" />
    <Move SourceFiles="$(PluginStageZip)" DestinationFiles="$(PluginZip)" />
    <Message Importance="high" Text="Plugin package: $(PluginZip)" />
  </Target>

</Project>
